# Локально — pooled URL Neon (без channel_binding)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require

# Vercel + Neon integration обычно задаёт POSTGRES_URL (приложение подхватит автоматически)
POSTGRES_URL=postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require

# Origins фронтенда через запятую (опционально, дополняет дефолтный список)
FRONTEND_URL=http://localhost:4173,http://localhost:5173,https://team-flow-fe-virid.vercel.app,https://team-flow-iwlet6sl3-alanks-projects-619353e8.vercel.app

DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require

# true — включить auto-sync только локально; на Vercel по умолчанию выключено
DB_SYNCHRONIZE=false

PORT=3000
